# Copy to .env and fill in. Never commit .env.

# Riot API key from https://developer.riotgames.com/ (development keys expire every 24 hours)
RIOT_API_KEY=your-riot-api-key

# Platform for ladder lookups (br1, na1, euw1, kr...) and the region that serves its matches (americas, europe, asia, sea)
RIOT_PLATFORM=br1
RIOT_REGION=americas

DATABASE_URL=postgresql://patchwise@localhost:5432/patchwise
